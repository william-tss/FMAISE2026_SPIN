proctype Worker() {
    // We use a blocked statement (false) to keep the process alive forever.
    // If it reached the end of the block, it would die and free up its PID!
    false; 
}
init {
    int count = 1; // Start at 1 because 'init' counts as the first process
    int spawned_pid;
    printf("Attempting to spawn 300 Worker processes...\n\n");
    // Loop 300 times
    do
    :: (count <= 300) ->
        // The 'run' command returns the new _pid, OR it returns 0 if it fails.
        spawned_pid = run Worker();
        if
        :: (spawned_pid == 0) -> 
            printf("\n>>> ERROR: SPIN refused to spawn process #%d! <<<\n", count + 1);
            break; // Exit the loop because we hit the wall
            
        :: else -> 
            // Print a status update every 50 processes to keep the console clean
            if
            :: (count % 50 == 0) -> printf("Successfully spawned %d processes...\n", count);
            :: else -> skip;
            fi;
        fi;
        count++;
    od;
    // Print the final system variables
    printf("\n=======================================\n");
    printf(" SYSTEM CAPACITY REACHED \n");
    printf("=======================================\n");
    printf("Total active processes (_nr_pr): %d\n", _nr_pr);
}

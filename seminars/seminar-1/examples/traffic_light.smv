MODULE main
VAR
  light : {red, green, yellow};

ASSIGN
  init(light) := red;

  next(light) := case
                   light = red    : green;
                   light = green  : yellow;
                   light = yellow : red;
                 esac;

-- SPECIFICATION (CTL)
-- AG = "Always Globally" (in all paths, in all states)
-- AX = "Always Next" (in all paths, in the immediate next state)

SPEC AG (light = red -> AX light = red)
